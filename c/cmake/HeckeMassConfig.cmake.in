@PACKAGE_INIT@

set(HeckeMass_HAS_FINITE_KERNEL @HECKE_MASS_BUILD_FINITE_KERNEL@)
set(HeckeMass_HAS_RVV @HECKE_MASS_ENABLE_RVV@)
set(HeckeMass_Scaffold_FOUND TRUE)
set(HeckeMass_FiniteKernel_FOUND @HECKE_MASS_BUILD_FINITE_KERNEL@)

if(@HECKE_MASS_BUILD_FINITE_KERNEL@)
    include("${CMAKE_CURRENT_LIST_DIR}/HeckeMassGMP.cmake")
    if(NOT TARGET HeckeMassGMP::GMP)
        set(HeckeMass_FOUND FALSE)
        set(HeckeMass_NOT_FOUND_MESSAGE "The HeckeMass finite kernel requires GMP headers and library.")
        return()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/HeckeMassTargets.cmake")
check_required_components(HeckeMass)
